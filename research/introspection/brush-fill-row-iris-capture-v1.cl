;;; Bounded natural boundary tape for BRUSH-FILL / FILL-IRIS review.
;;; This observer makes no application calls except the wrapped originals.
(in-package :cl-user)

(unless (boundp 'aaron-brush-fill-row-iris-capture-v1-loaded)
  (set 'aaron-brush-fill-row-iris-capture-v1-loaded t)
  (let* ((owner (find-package "COMMON-GRAPHICS-USER"))
         (report (open "C:\\temp\\aaron-brush-fill-row-iris.txt"
                       :direction :output :if-exists :supersede
                       :if-does-not-exist :create))
         (targets '("BRUSH-FILL" "FILL-IRIS" "CFRAME" "SCAN-ROW"
                    "PATCH-EDGE" "MY-FILL" "SELECT-BRUSH" "IDLIST"
                    "CFORM-COUNT"))
         (names (append targets '("MAIN")))
         (parent-limit 500) (call-limit 150000) (object-limit 30000)
         (value-limit 64) (list-item-limit 1024) (list-depth-limit 6)
         (ids (make-hash-table :test #'eq)) (next-id 0)
         (originals (make-hash-table :test #'equal))
         (wrappers (make-hash-table :test #'equal))
         (stats (make-hash-table :test #'equal))
         (ordinals (make-hash-table :test #'equal))
          (last-frames (make-hash-table :test #'eql))
          (scan-history (make-hash-table :test #'eql))
         (overflow-kinds (make-hash-table :test #'equal))
         (stack nil) (calls 0) (returns 0) (parents 0) (objects 0)
         (errors 0) (aborts 0) (records 0) (busy 0)
         (overflow nil) (capturing nil) (finished nil))
    (dolist (name names) (setf (gethash name stats) (vector 0 0 0)))
    (labels
        ((emit (control &rest args)
           (when report
             (handler-case
                 (let ((*print-length* nil) (*print-level* nil)
                       (*print-pretty* nil) (*print-circle* nil)
                       (*print-readably* nil))
                   (apply #'format report control args)
                   (terpri report)
                   (incf records)
                   t)
               (condition () (incf errors) nil))))
         (overflow-note (kind detail)
           (setf overflow t)
           (unless (gethash kind overflow-kinds)
             (setf (gethash kind overflow-kinds) t)
             (emit "OVERFLOW kind=~S detail=~S" kind detail)))
         (type-name (value)
           (format nil "~S" (type-of value)))
         (object-id (value)
           (multiple-value-bind (prior present) (gethash value ids)
             (if present prior
               (if (>= objects object-limit)
                   (progn
                     (overflow-note :objects object-limit)
                     :object-cap)
                 (let ((id (incf next-id)))
                   (incf objects)
                   (setf (gethash value ids) id)
                   id)))))
         (identity-info (value)
           (list :eq (object-id value) :type (type-name value)))
         (datum (value &optional (depth 0))
           (cond
             ((null value) (list :nil))
             ((numberp value) (list :number (type-name value) value))
             ((symbolp value)
              (list :symbol
                    (and (symbol-package value)
                         (package-name (symbol-package value)))
                    (symbol-name value)))
             ((stringp value) (list :string value))
             ((consp value) (list-datum value depth))
             ((arrayp value)
              (list :array :eq (object-id value) :type (type-name value)
                    :rank (array-rank value) :dims (array-dimensions value)))
             (t (list :object :eq (object-id value) :type (type-name value)))) )
         (opaque-datum (value)
           (if (consp value)
               (list :object :eq (object-id value) :type (type-name value)
                     :contents :omitted)
             (datum value)))
         (list-datum (value depth)
           (if (>= depth list-depth-limit)
               (progn
                 (overflow-note :list-depth list-depth-limit)
                 (list :list :items nil :shown 0 :proper nil :truncated t
                       :tail '(:depth-limit)))
             (let ((rest value) (items nil) (shown 0)
                   (seen (make-hash-table :test #'eq)) (stopped nil))
               (do () ((or (not (consp rest)) stopped))
                 (when (or (>= shown list-item-limit) (gethash rest seen))
                   (setf stopped t)
                   (if (>= shown list-item-limit)
                       (overflow-note :list-items list-item-limit)
                     (overflow-note :list-cycle shown))
                   (return))
                 (setf (gethash rest seen) t)
                 (push (datum (car rest) (1+ depth)) items)
                 (incf shown)
                 (setf rest (cdr rest)))
               (when (and rest (not stopped))
                 (overflow-note :improper-list depth))
               (list :list :items (nreverse items) :shown shown
                     :proper (null rest) :truncated stopped
                     :tail (cond (stopped '(:truncated))
                                 ((null rest) '(:nil))
                                 (t (datum rest (1+ depth))))))))
         (summary (values)
           (let ((rest values) (items nil) (shown 0))
             (do () ((or (null rest) (>= shown value-limit)))
               (push (datum (car rest)) items)
               (incf shown)
               (setf rest (cdr rest)))
             (when rest (overflow-note :values value-limit))
             (list :items (nreverse items) :count shown
                   :truncated (not (null rest)))))
         (opaque-summary (values)
           (let ((rest values) (items nil) (shown 0))
             (do () ((or (null rest) (>= shown value-limit)))
               (push (opaque-datum (car rest)) items)
               (incf shown)
               (setf rest (cdr rest)))
             (when rest (overflow-note :values value-limit))
             (list :items (nreverse items) :count shown
                   :truncated (not (null rest)))))
          (call-args-summary (name args)
            (if (member name '("PATCH-EDGE" "IDLIST" "CFRAME" "SCAN-ROW")
                        :test #'string=)
                (opaque-summary args)
              (summary args)))
          (return-summary (name values)
            (if (member name '("PATCH-EDGE" "IDLIST" "CFRAME" "SCAN-ROW")
                        :test #'string=)
                (opaque-summary values)
              (summary values)))
          (global-binding (name)
            (let ((symbol (find-symbol name owner)))
              (cond ((null symbol) (list name :missing))
                    ((not (boundp symbol)) (list name :unbound))
                    (t (list name :bound
                             (if (string= name "BRUSH")
                                (opaque-datum (symbol-value symbol))
                               (datum (symbol-value symbol))))))))
          (map-binding (name)
            (let ((symbol (find-symbol name owner)))
              (cond ((null symbol) (list name :missing))
                    ((not (boundp symbol)) (list name :unbound))
                    (t (let ((map (symbol-value symbol)))
                         (list name :bound
                               (if (arrayp map)
                                   (list :array :eq (object-id map)
                                         :type (type-name map)
                                         :rank (array-rank map)
                                         :dims (array-dimensions map))
                                 (opaque-datum map))))))))
         (state-for (name)
           (cond
             ((string= name "FILL-IRIS")
              (list :globals (mapcar #'global-binding
                                     '("SUBP-COUNT" "CFORM-COUNT" "BRUSH" "HEAD-DONE"))
                    :maps (mapcar #'map-binding '("FILL-MAP" "PATCH-MAP"))))
             ((member name '("MY-FILL" "SELECT-BRUSH" "CFORM-COUNT") :test #'string=)
              (list :globals (mapcar #'global-binding
                                     '("SUBP-COUNT" "CFORM-COUNT" "BRUSH" "HEAD-DONE"))))
             (t '(:none))))
         (direct-slot (object name)
           (let ((slot (find-symbol name owner)))
             (cond ((null slot) (list :missing))
                   ((not (slot-boundp object slot)) (list :unbound))
                   (t (let ((value (slot-value object slot)))
                        (if (integerp value)
                            (list :integer value)
                          (list :non-integer (datum value))))))))
         (frame-info (value)
           (if (null value) '(:nil)
             (list :eq (object-id value) :type (type-name value)
                   :ly (direct-slot value "LY")
                   :ty (direct-slot value "TY"))))
         (point-info (value)
           (if (null value) '(:nil)
             (list :eq (object-id value) :type (type-name value)
                   :x (direct-slot value "X")
                   :y (direct-slot value "Y")
                   :z (direct-slot value "Z"))))
         (fill-id ()
           (let ((rest stack) (found nil))
             (do () ((or (null rest) found))
               (when (string= (getf (car rest) :name) "BRUSH-FILL")
                 (setf found (getf (car rest) :fill)))
               (setf rest (cdr rest)))
             (or found 0)))
         (cframe-context (fill)
           (or (gethash fill last-frames)
               '(:cframe-id 0 :form-eq 0 :frame-eq 0)))
          (scan-links (fill start)
            (let* ((by-point (gethash fill scan-history))
                   (rest (and start by-point (gethash start by-point)))
                   (links nil) (shown 0))
              (do () ((or (null rest) (>= shown list-item-limit)))
                (push (car rest) links)
                (incf shown)
                (setf rest (cdr rest)))
              (when rest
                (overflow-note :scan-links
                               (list :limit list-item-limit
                                     :point-eq (object-id start))))
              links))
         (idlist-result (values)
           (if (and values (null (cdr values))
                    (or (consp (car values)) (null (car values))))
               (let ((rest (car values)) (items nil) (shown 0)
                     (seen (make-hash-table :test #'eq)) (stopped nil))
                 (do () ((or (not (consp rest)) stopped))
                   (when (or (>= shown list-item-limit) (gethash rest seen))
                     (setf stopped t)
                     (if (>= shown list-item-limit)
                         (overflow-note :idlist-items list-item-limit)
                       (overflow-note :idlist-cycle shown))
                     (return))
                   (setf (gethash rest seen) t)
                   (push (datum (car rest)) items)
                   (incf shown)
                   (setf rest (cdr rest)))
                 (when (and rest (not stopped))
                   (overflow-note :idlist-improper shown))
                 (list :items (nreverse items) :count shown
                       :proper (and (null rest) (not stopped))
                       :truncated stopped
                       :tail (cond (stopped '(:truncated))
                                   ((null rest) '(:nil))
                                   (t (datum rest)))))
             (list :items nil :count 0 :proper nil :truncated nil
                   :tail (if values (datum (car values)) '(:no-single-list-value)))))
         (context-for (name args values phase id fill ordinal)
           (cond
             ((string= name "BRUSH-FILL")
              (list :fill-ordinal ordinal))
             ((string= name "FILL-IRIS")
              (list :fill-ordinal fill))
             ((string= name "CFRAME")
              (let ((form (car args)) (frame (and (eq phase :after) (car values))))
                (if (eq phase :before)
                    (list :form (if form (identity-info form) '(:nil)))
                  (let* ((frame-data (frame-info frame))
                         (entry (list :cframe-id id
                                      :form-eq (if form (object-id form) 0)
                                      :frame-eq (if frame (object-id frame) 0))))
                    (setf (gethash fill last-frames) entry)
                    (list :form (if form (identity-info form) '(:nil))
                          :frame frame-data :cframe-id id)))))
             ((string= name "SCAN-ROW")
              (if (eq phase :before)
                  (list :cframe (cframe-context fill) :scan-ordinal ordinal)
                (let* ((point (car values))
                       (point-data (point-info point))
                       (point-eq (if point (object-id point) 0))
                       (entry (list :scan-call-id id :scan-ordinal ordinal
                                    :point-eq point-eq)))
                   (when (and (plusp fill) point)
                     (let ((by-point
                             (or (gethash fill scan-history)
                                 (setf (gethash fill scan-history)
                                       (make-hash-table :test #'eq)))))
                       (setf (gethash point by-point)
                             (cons entry (gethash point by-point)))))
                  (list :cframe (cframe-context fill)
                        :scan-ordinal ordinal :point point-data))))
              ((string= name "PATCH-EDGE")
               (let ((start (car args)))
                  (if (eq phase :before)
                     (list :start (if start (identity-info start) '(:nil))
                           :scan-links (scan-links fill start))
                   (list :start (if start (identity-info start) '(:nil))
                         :scan-links (scan-links fill start)))))
             ((string= name "IDLIST")
              (let ((form (car args)))
                (if (eq phase :before)
                    (list :form (if form (identity-info form) '(:nil)))
                  (list :form (if form (identity-info form) '(:nil))))))
             ((member name '("MY-FILL" "SELECT-BRUSH" "CFORM-COUNT") :test #'string=)
              (list :fill-ordinal fill))
             (t (list :fill-ordinal fill))))
         (observation (id name phase thunk)
           (let ((preview-before nil) (preview-after nil) (data nil)
                 (stable nil) (failed nil))
             (incf busy)
             (unwind-protect
                 (handler-case
                     (progn
                       (setf preview-before (aaron-random-state-preview))
                       (setf data (funcall thunk))
                       (setf preview-after (aaron-random-state-preview))
                       (setf stable (and (consp preview-before)
                                         (eq (car preview-before) :random-100-1)
                                         (equal preview-before preview-after)))
                       (unless stable
                         (setf failed t)
                         (incf errors)
                         (emit "OBSERVATION-ERROR id=~D name=~S phase=~S reason=:rng-preview-changed"
                               id name phase)))
                   (condition ()
                     (setf failed t data (list :observation-error phase))
                     (incf errors)
                     (emit "OBSERVATION-ERROR id=~D name=~S phase=~S reason=:snapshot-failed"
                           id name phase)))
               (decf busy))
             (values data
                     (list :before (if preview-before (datum preview-before) '(:unavailable))
                           :after (if preview-after (datum preview-after) '(:unavailable))
                           :stable (and stable (not failed))))))
         (note-overflow (kind id detail)
           (overflow-note kind (list :call-id id :detail detail)))
         (invoke (name original args)
           (cond
             ((or (not capturing) (null report))
              (if (and (string= name "MAIN") (not finished) report)
                  (progn
                    (setf capturing t)
                    (invoke-recorded name original args))
                (apply original args)))
             ((plusp busy)
              (incf errors)
              (note-overflow :observer-reentry (1+ calls) name)
              (apply original args))
             (t (invoke-recorded name original args))))
         (invoke-recorded (name original args)
           (let* ((id (incf calls))
                  (ordinal (1+ (gethash name ordinals 0)))
                  (parent (if stack (getf (car stack) :id) 0))
                  (fill (if (string= name "BRUSH-FILL") ordinal (fill-id)))
                  (main-p (string= name "MAIN"))
                  (record-p (<= calls call-limit))
                  (completed nil)
                  (frame (list :id id :name name :ordinal ordinal :fill fill)))
             (setf (gethash name ordinals) ordinal)
             (incf (aref (gethash name stats) 0))
             (when (string= name "BRUSH-FILL")
               (incf parents)
               (when (> parents parent-limit)
                 (setf record-p nil)
                 (note-overflow :parents id parent-limit)))
             (when (> calls call-limit)
               (setf record-p nil)
               (note-overflow :calls id call-limit))
             (push frame stack)
             (when record-p
               (multiple-value-bind (before rng)
                   (observation id name :before
                     (lambda ()
                       (list :args (call-args-summary name args)
                             :state (state-for name)
                             :context (context-for name args nil :before id fill ordinal))))
                 (emit "CALL id=~D parent=~D fill=~D ordinal=~D name=~S args=~S before=~S rng=~S"
                       id parent fill ordinal name (getf before :args)
                       (list :state (getf before :state) :context (getf before :context)) rng)))
             (unwind-protect
                 (multiple-value-call
                     (lambda (&rest values)
                       (incf returns)
                       (incf (aref (gethash name stats) 1))
                       (when record-p
                         (multiple-value-bind (after rng)
                             (observation id name :after
                               (lambda ()
                                 (list :values (return-summary name values)
                                       :idlist (and (string= name "IDLIST")
                                                    (idlist-result values))
                                       :state (state-for name)
                                       :context (context-for name args values :after id fill ordinal))))
                           (if (string= name "IDLIST")
                               (emit "RETURN id=~D name=~S values=~S idlist=~S after=~S rng=~S"
                                     id name (getf after :values) (getf after :idlist)
                                     (list :state (getf after :state) :context (getf after :context)) rng)
                             (emit "RETURN id=~D name=~S values=~S after=~S rng=~S"
                                   id name (getf after :values)
                                   (list :state (getf after :state) :context (getf after :context)) rng))))
                       (setf completed t)
                       (values-list values))
                   (apply original args))
               (unless completed
                 (incf aborts)
                 (incf (aref (gethash name stats) 2))
                 (when record-p (emit "ABORT id=~D name=~S fill=~D" id name fill)))
               (if (and stack (eql (getf (car stack) :id) id))
                   (pop stack)
                 (progn
                   (incf errors)
                   (note-overflow :stack id :mismatched-pop)
                   (setf stack (remove frame stack :test #'eq))))
               (when (and main-p (not finished))
                 (finish (if completed "normal" "aborted")))
               (when (and report (zerop (mod id 256)))
                 (handler-case (finish-output report)
                   (condition () (incf errors)))))))
         (install (name)
           (let* ((symbol (find-symbol name owner))
                  (original (and symbol (fboundp symbol) (symbol-function symbol))))
             (unless original (error "Missing required natural boundary ~A" name))
             (setf (gethash name originals) original)
             (let ((wrapper (lambda (&rest args) (invoke name original args))))
               (setf (gethash name wrappers) wrapper)
               (setf (symbol-function symbol) wrapper)
               (emit "INSTALL name=~S status=:ok" name))))
         (restore-one (name)
           (let ((symbol (find-symbol name owner))
                 (wrapper (gethash name wrappers))
                 (original (gethash name originals)))
             (cond
               ((null wrapper) (emit "RESTORE name=~S status=:not-installed" name))
               ((and symbol (fboundp symbol) (eq (symbol-function symbol) wrapper))
                (handler-case
                    (progn
                      (setf (symbol-function symbol) original)
                      (emit "RESTORE name=~S status=:restored" name))
                  (condition ()
                    (incf errors)
                    (emit "RESTORE name=~S status=:error" name))))
               (t
                (emit "RESTORE name=~S status=:changed" name)))))
         (finish (status)
           (unless finished
             (setf finished t capturing nil)
             (dolist (name (reverse targets)) (restore-one name))
             (restore-one "MAIN")
             (dolist (name names)
               (let ((counts (gethash name stats)))
                 (emit "TOTAL name=~S calls=~D returns=~D aborts=~D"
                       name (aref counts 0) (aref counts 1) (aref counts 2))))
             (incf records 2)
             (emit "COMPLETE main=~A parents=~D calls=~D returns=~D objects=~D records=~D errors=~D aborts=~D overflow=~S depth=~D busy=~D"
                   status parents calls returns objects records errors aborts overflow
                   (length stack) busy)
             (emit "END brush-fill-row-iris-v1")
             (when report
               (handler-case (progn (finish-output report) (close report))
                 (condition () (incf errors)))
               (setf report nil))))
      )
      (emit "BEGIN brush-fill-row-iris v1")
      (emit "CAPS parents=500 calls=150000 objects=30000 values=64 list-items=1024 list-depth=6")
      (handler-case
          (progn
            (dolist (name targets) (install name))
            (install "MAIN")
            (emit "READY")
            (finish-output report))
        (condition ()
          (incf errors)
          (emit "SETUP-ERROR reason=:installation-failed")
          (finish "setup-failed"))))))
